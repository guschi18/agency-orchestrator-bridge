{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3-flash",
  "mcp": {
    "graft": {
      "type": "local",
      "command": ["graft", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "graft*": "allow",
      "npx graft*": "allow",
      "node dist/cli.js*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "gh *": "allow",
      "Get-ChildItem*": "allow",
      "Get-Content*": "allow",
      "sudo *": "deny",
      "chmod 777*": "deny"
    },
    "skill": {
      "*": "allow"
    },
    "webfetch": "ask",
    "websearch": "allow",
    "external_directory": {
      "~/AppData/Local/Temp/opencode/**": "allow"
    }
  }
}
